<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TrackpadClicks</AssemblyName>
    <RootNamespace>TrackpadClicks</RootNamespace>
    <Version>0.4.11</Version>
    <!-- The WebView2 package also brings its WPF control, unused here, built against a newer WindowsBase. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ui/settings.html" LogicalName="settings.html" />
    <!-- Written out next to the settings by SettingsWindow: a copy extracted to %TEMP% is
         deleted by Windows' temp cleanup while the app runs for days. -->
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2/1.0.4258.31/runtimes/win-x64/native/WebView2Loader.dll" LogicalName="WebView2Loader.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
